# --- Supabase -------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API Keys.
# The publishable key is meant to be sent to the browser; row level security,
# not this key, is what keeps your data private. Never put the secret /
# service-role key in here - it bypasses row level security entirely.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Older projects issue a JWT called the anon key instead; that name still works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- The one account ------------------------------------------------------
# This app has a single user. The login screen asks for a password only; this
# is the email it signs in with, and it must match the user in Supabase ->
# Authentication -> Users. It has no NEXT_PUBLIC_ prefix on purpose, so the
# address is never sent to the browser. The password itself lives nowhere but
# Supabase, which stores it hashed.
OWNER_EMAIL=you@example.com

# --- Anthropic ------------------------------------------------------------
# Used server-side only, for reading receipts. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- App ------------------------------------------------------------------
# Public origin, used for absolute links. Locally this is http://localhost:3000;
# on Vercel, set it to your deployment URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
