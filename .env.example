# --- Supabase -------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Anthropic ------------------------------------------------------------
# Used server-side only, for reading receipts. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- App ------------------------------------------------------------------
# Public origin, used to build the magic-link redirect. Vercel sets
# NEXT_PUBLIC_SITE_URL for you if you add it as an env var; locally this is
# http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
